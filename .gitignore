# Generated TypeDoc artifact consumed by Mintlify. Rebuilt by
# `npm run docs:mintlify`; it is a build input, not a source file.
mintlify/sdk-artifacts/

# Staging area for the two files published to the docs-v2 repo. Rebuilt by
# `npm run docs:docsv2`; both are generated, so neither is tracked here.
mintlify/docsv2/

# TypeDoc auto-discovers `typedoc.json` as a config file, so writing an artifact
# there breaks the next run. Ignored to catch a stray
# `npx typedoc --json typedoc.json`.
/typedoc.json

